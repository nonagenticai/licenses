# Database Configuration
POSTGRES_PASSWORD_LICENSES=your_secure_password_here
DATABASE_URL=postgresql+psycopg://licenses_user:your_secure_password_here@localhost:5432/licenses?sslmode=disable

# Keycloak Configuration
KEYCLOAK_URL=https://keycloak.example.com:8443
REALM_NAME=secure-apps

# Application Settings
PORT=8544
NODE_ENV=production
ENVIRONMENT=development
ENABLE_DOCS=true
DEFAULT_TENANT_ID=demo

# Comma-separated list of allowed CORS origins.
# When unset, falls back to a dev-friendly default (localhost and private-use suffixes).
# Production should set this explicitly:
# CORS_ALLOWED_ORIGINS=https://portal.nonagentic.ai,https://licenses.nonagentic.ai
CORS_ALLOWED_ORIGINS=
